{
  "name": "wave-collector",
  "private": true,
  "version": "0.1.0",
  "description": "Windows multi-channel waveform acquisition and session splitter for zhuru_wave",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:native": "node scripts/build-native.mjs",
    "build:web": "electron-vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "build": "pnpm build:native && pnpm typecheck && pnpm build:web",
    "build:win": "pnpm build && electron-builder --win nsis",
    "build:unpack": "pnpm build && electron-builder --dir",
    "test:native": "node scripts/test-native.mjs",
    "test": "pnpm test:rates && pnpm build:native && pnpm test:native",
    "start": "electron-vite preview",
    "test:rates": "node --experimental-strip-types scripts/test-rate-table.mjs",
    "test:preload": "node scripts/test-preload.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.10.4",
    "pinia": "^3.0.3",
    "vue": "^3.5.17"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@types/node": "^22.16.5",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.5",
    "vue-tsc": "^3.0.3"
  },
  "packageManager": "pnpm@10.11.0"
}
